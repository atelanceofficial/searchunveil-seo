{
  "name": "searchunveil",
  "version": "0.1.0",
  "private": true,
  "description": "SearchUnveil: understand how your website gets found. An early, local-first prototype by Atelance.",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @searchunveil/web",
    "build": "npm run build --workspace @searchunveil/web",
    "preview": "npm run preview --workspace @searchunveil/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e --workspace @searchunveil/web",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/core && tsc -p apps/web && tsc -p apps/web/tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "patterns": "node scripts/generate-patterns.ts",
    "check": "npm run check:text && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "check:text": "node scripts/check-source-text.ts",
    "check:links": "node scripts/check-links.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
